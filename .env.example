# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM provider (used from Phase 8 onward: intent classifier, generation, judge) ---
# Using Google Gemini's free tier (see DECISION_LOG.md). Get a free key at
# https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# --- Embedding model (used from Phase 9 onward: retrieval) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Project scope (fixed in Phase 2, see DECISION_LOG.md) ---
SELECTED_BRAND=SpotifyCares

# --- Retrieval / escalation tuning (safe defaults, override as needed) ---
TOP_K=5
MIN_INTENT_CONFIDENCE=0.6
MIN_RETRIEVAL_SIMILARITY=0.70

# --- Reproducibility ---
RANDOM_SEED=42

# --- Paths (defaults are relative to project root; override if needed) ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_GOLDEN_DIR=data/golden
