# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment / secrets
.env

# Raw dataset — large, never commit (fetched separately, see README)
data/raw/*
!data/raw/.gitkeep

# Large derived datasets (rebuilt by scripts/*, sizes track the raw data).
# Small analysis/inspection reports (brand_statistics.csv, dataset_summary.json,
# preprocessing_stats.json, support_cases_sample.jsonl, intent_discovery_clusters.json,
# intent_distribution.json) are intentionally NOT excluded here since they're
# cheap and are the deliverable evidence.
data/processed/support_cases.jsonl
data/processed/support_cases_with_intents.jsonl

# Vector indexes and model artifacts (rebuildable, can be large). The
# knowledge index specifically IS committed despite this section's general
# rule - it's needed for the hosted Streamlit demo to run without requiring
# a rebuild from the raw dataset (which isn't available on a cloud host).
*.faiss
*.index
data/index/*
!data/index/knowledge.faiss
!data/index/knowledge_metadata.jsonl

# LLM raw-prediction resumability caches (implementation detail, not a
# phase deliverable — the corresponding *_predictions.jsonl file is the real output)
artifacts/predictions/ai_classifier_raw_cache.jsonl
artifacts/predictions/golden_predictions_raw_cache.jsonl

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Streamlit
.streamlit/
