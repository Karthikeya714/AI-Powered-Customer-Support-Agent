# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment / secrets
.env

# Raw dataset — large, never commit (fetched separately, see README)
data/raw/*
!data/raw/.gitkeep

# Large derived datasets (rebuilt by scripts/*, sizes track the raw data) —
# small analysis reports like brand_statistics.csv/dataset_summary.json
# are intentionally NOT excluded here since they're cheap and are the
# deliverable evidence for brand selection.
data/processed/support_cases.jsonl
data/processed/support_cases_sample.jsonl

# Vector indexes and model artifacts (rebuildable, can be large)
*.faiss
*.index
data/index/

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Streamlit
.streamlit/
